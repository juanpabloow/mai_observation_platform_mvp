+def _clean_words(
+    raw: Any, seg_start: float, seg_end: float
+) -> list[dict[str, Any]]:
+    """
+    Las palabras de un segmento, listas para que mai las acepte.
+
+    mai valida que cada palabra este DENTRO de su segmento y en orden, y rechaza el
+    artefacto entero si no — asi que se recortan aqui en vez de descubrirlo al final
+    del pipeline, con la GPU ya gastada.
+
+    NO se inventa ninguna: un segmento sin palabras sale sin la clave, y mai lo trata
+    como v1. Y no se descarta ninguna con texto: mai solo parte un segmento cuando sus
+    palabras se corresponden UNA A UNA con los tokens del texto, asi que tirar una
+    palabra por tener tiempos ilegibles costaria la particion entera de ese segmento.
+    Por eso una palabra con tiempos malos hereda el final de la anterior en vez de
+    desaparecer: conserva la correspondencia, y su duracion nula es visible.
+    """
+    if not isinstance(raw, list) or not raw:
+        return []
+    out: list[dict[str, Any]] = []
+    cursor = seg_start
+    for item in raw:
+        if not isinstance(item, Mapping):
+            continue
+        text = str(item.get("word", ""))
+        if text == "":
+            continue
+        try:
+            w_start = float(item.get("start"))
+            w_end = float(item.get("end"))
+        except (TypeError, ValueError):
+            # Sin tiempos utiles: se ancla al cursor con duracion cero. Se conserva
+            # para no romper la correspondencia uno a uno con el texto.
+            w_start = w_end = cursor
+        w_start = min(max(w_start, cursor), seg_end)
+        w_end = min(max(w_end, w_start), seg_end)
+        out.append({"start": round(w_start, 3), "end": round(w_end, 3), "word": text})
+        cursor = w_end
+    return out
+
