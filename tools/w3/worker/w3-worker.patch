+    if raw is None:
+        return None
+    if isinstance(raw, bool):  # bool es int en Python; `True` no es «un hablante»
+        logger.warning("speakerCount booleano (%r): se diariza en automatico", raw)
+        return None
+    try:
+        value = int(raw)
+    except (TypeError, ValueError):
+        logger.warning("speakerCount no numerico (%r): se diariza en automatico", raw)
+        return None
+    if not SPEAKER_COUNT_MIN <= value <= SPEAKER_COUNT_MAX:
+        logger.warning("speakerCount fuera de rango (%r): se diariza en automatico", raw)
+        return None
