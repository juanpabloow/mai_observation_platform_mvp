+    def unload(self) -> bool:
+        """
+        Suelta el modelo y devuelve la VRAM. Idempotente: si no había nada cargado,
+        no hace nada y devuelve False.
+
+        ── Por qué existe ────────────────────────────────────────────────────
+
+        En la GTX 1650 SUPER no caben whisper y pyannote a la vez. Medido: de los
+        3717 MiB utilizables, el servicio histórico de la máquina ocupa 960 fijos,
+        whisper `medium` residente 1160 y pyannote 1670. Los dos juntos son 2830
+        contra 2757 disponibles — se pasa por ~73 MiB, y el resultado es un OOM que
+        cae al backend de reserva sin que nadie se entere.
+
+        `transcribe` y `diarize` son jobs distintos, así que nunca hace falta que
+        coexistan: cada etapa suelta el modelo de la otra antes de cargar el suyo. El
+        coste es recargar, y se paga una vez por job.
+
+        ── Cómo se libera de verdad ──────────────────────────────────────────
+
+        `WhisperModel` es un envoltorio de CTranslate2, que NO usa el asignador de
+        torch: su memoria la libera su propio destructor en C++. Así que lo que
+        importa es soltar la última referencia y forzar la recolección; llamar a
+        `torch.cuda.empty_cache()` no devolvería esta memoria. Se llama igualmente
+        porque en el mismo proceso vive pyannote, que sí usa torch, y ahí sí sirve.
+
+        Se toma el MISMO lock que `_ensure_model`: sin él, un hilo podría estar
+        cargando mientras otro descarga, y acabaríamos con un modelo huérfano
+        ocupando VRAM que ya nadie puede liberar.
+        """
+        with self._lock:
+            if self._model is None:
+                return False
+            logger.info("Liberando el modelo Whisper de la memoria…")
+            self._model = None
+            # `_load_error` se limpia: el estado anterior era «cargado», no «falló».
+            self._load_error = None
+
+        import gc
+
+        gc.collect()
+        try:
+            import torch  # noqa: PLC0415 — diferido, como el resto
+
+            if torch.cuda.is_available():
+                torch.cuda.empty_cache()
+        except Exception as exc:  # noqa: BLE001 — liberar es best-effort
+            logger.warning("No se pudo vaciar la caché de CUDA: %s", exc)
+        logger.info("Modelo Whisper liberado.")
+        return True
